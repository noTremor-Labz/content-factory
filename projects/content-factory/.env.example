# Shared application settings
APP_NAME=Content Factory
APP_ENV=development
APP_URL=http://localhost:3000
SENTRY_DSN=

# Web
VITE_APP_NAME=Content Factory Control Plane
VITE_API_BASE_URL=/

# API
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql://content_factory:content_factory@localhost:5432/content_factory
REDIS_URL=redis://localhost:6379/0
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
INVITE_EXPIRATION_HOURS=72
UPLOAD_URL_EXPIRATION_MINUTES=30

# Worker
WORKER_NAME=content-factory-worker
WORKER_CONCURRENCY=1

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=content-factory-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# AI providers
OPENAI_API_KEY=

# Future workflow/render backend
COMFYUI_BASE_URL=
