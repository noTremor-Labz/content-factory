# Скопируй в .env: cp .env.example .env
# Секреты (ключи) можно держать отдельно в .env.local или ~/.config/content-factory.env — см. scripts/load-env.sh

# ─── LLM (только маркетплейсы инференса, без прямых ключей Anthropic/Moonshot/Minimax) ─
# OpenRouter: нужен ключ для вызова моделей (chat). Ключи вида management/provisioning дают 401 на /chat/completions.
OPENROUTER_API_KEY=
# Commonstack: https://docs.commonstack.ai/overview/quickstart
COMMONSTACK_API_KEY=
# Together AI: https://www.together.ai/
TOGETHER_API_KEY=
# Какой маркетплейс подставлять в OpenClaw (sessions_spawn model=...): openrouter | commonstack | together
# После смены: python3 scripts/apply-llm-marketplace.py и перезапусти gateway
LLM_MARKETPLACE=openrouter
# Слот модели в config/llm-model-registry.json: 0 = primary, 1+ = alternatives (если заданы для маркетплейса)
# LLM_KIMI_SLOT=0
# LLM_MINIMAX_SLOT=0
# Выбор по подстроке id (например mimo-v2-pro); переопределяет SLOT, если найден в списке слотов
# LLM_KIMI_PICK=
# LLM_MINIMAX_PICK=

# ─── Telegram ──────────────────────────────────────────
# Director / OpenClaw (один бот на чат с агентами)
TELEGRAM_BOT_TOKEN=
# Согласование постов в n8n (approval-send / telegram-router). Пусто → в workflow подставится TELEGRAM_BOT_TOKEN.
TELEGRAM_APPROVAL_BOT_TOKEN=
# Куда n8n шлёт превью с кнопками (chat id группы или лички). Не брать из тела webhook — только env.
APPROVE_CHAT_ID=
# Алиас для старых конфигов (если задан, подхватывается тем же узлом)
TELEGRAM_APPROVAL_CHAT_ID=
TELEGRAM_OWNER_ID=
# Отдельный бот «References»: только приём референсов в n8n → style-examples.md (см. n8n/workflows/references-style-examples.json)
TELEGRAM_REFERENCES_BOT_TOKEN=

# ─── OpenClaw Gateway ──────────────────────────────────
# OPENCLAW_GATEWAY_TOKEN подставит scripts/1-openclaw-setup.sh после онбординга
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_CONFIG_DIR=/Users/YOUR_USERNAME/.openclaw
OPENCLAW_WORKSPACE_DIR=/Users/YOUR_USERNAME/.openclaw/workspace
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789

# ─── Agent Board ───────────────────────────────────────
AGENTBOARD_API_KEYS=sk-director:director,sk-scout:scout,sk-quill:quill-tomas,sk-lens:lens,sk-pixel:pixel-tomas,sk-launch:launch,sk-n8n:n8n
AGENTBOARD_WEBHOOK_SECRET=local-dev-secret-change-me
OPENCLAW_HOOK_TOKEN=local-dev-hook-token
# Bearer для n8n → POST openclaw-gateway/hooks/agent — скопируй из ~/.openclaw/openclaw.json поле hooks.token (не gateway.auth.token)
OPENCLAW_HOOKS_TOKEN=

# ─── n8n ───────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=localdev123
# Локально по http:// — оставь false; для HTTPS в проде можно true
N8N_SECURE_COOKIE=false
# Строка false — иначе в узлах «access to env vars denied» при {{ $env.... }}
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Ключ для X-API-Key к Agent Board из workflow ($env.N8N_AGENT_BOARD_API_KEY); должен совпадать с записью в AGENTBOARD_API_KEYS
N8N_AGENT_BOARD_API_KEY=sk-n8n
# Опционально: переопределить базовый URL (по умолчанию в compose: http://agent-board:3456)
# AGENT_BOARD_URL=http://agent-board:3456
# База для вызовов к OpenClaw gateway из n8n (внутри Docker-сети)
OPENCLAW_GATEWAY_INTERNAL_URL=http://openclaw-gateway:18789
# n8n workflow references-style-examples: один chat_id на блогера (числовой id чата с ботом References), без команд
# TELEGRAM_STYLE_CHAT_TOMAS=
# TELEGRAM_STYLE_CHAT_MISHA=
# TELEGRAM_STYLE_CHAT_YULYA=
# TELEGRAM_STYLE_CHAT_NASIK=

# ─── Пути на хосте (замени YOUR_USERNAME и при необходимости путь к клону репо)
HOST_SHARED_PATH=/Users/YOUR_USERNAME/dev/projects/agents/content-factory/shared
HOST_AGENT_BOARD_PATH=/Users/YOUR_USERNAME/dev/projects/agents/content-factory/agent-board/dist
HOST_AGENT_BOARD_DASHBOARD=/Users/YOUR_USERNAME/dev/projects/agents/content-factory/agent-board/dashboard
# FileBrowser: корень файлового менеджера = весь репозиторий content-factory (в т.ч. shared/, souls/, scripts/)
HOST_FILEBROWSER_ROOT=/Users/YOUR_USERNAME/dev/projects/agents/content-factory
