{
  "id": "f2962009-42b4-4696-be22-dd149037be0a",
  "name": "stuck-alerts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      },
      "id": "a1c2e3f4-1111-4222-8333-444455556666",
      "name": "Every 6 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.AGENT_BOARD_URL }}/api/health",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.N8N_AGENT_BOARD_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b2d3f4a5-2222-5333-9444-555566667777",
      "name": "Ping Agent Board",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENCLAW_GATEWAY_INTERNAL_URL }}/hooks/agent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.OPENCLAW_HOOKS_TOKEN || $env.OPENCLAW_HOOK_TOKEN || '') }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": \"Плановый мониторинг зависших задач (workflow stuck-alerts, каждые 6 ч). Узел «Ping Agent Board» уже проверил health. Проверь shared/bloggers/*/jobs/ на зависшие состояния, при необходимости сверься с Agent Board и предложи retry или эскалацию.\",\n  \"agentId\": \"scheduler\",\n  \"wakeMode\": \"now\"\n}",
        "options": {}
      },
      "id": "e1f2a3b4-5555-6666-7777-888899990001",
      "name": "Wake Scheduler",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [520, 0]
    }
  ],
  "connections": {
    "Every 6 hours": {
      "main": [
        [
          {
            "node": "Ping Agent Board",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ping Agent Board": {
      "main": [
        [
          {
            "node": "Wake Scheduler",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": true }
}
