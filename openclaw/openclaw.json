{
  "agents": {
    "list": [
      {
        "id": "director",
        "workspace": "/home/node/.openclaw/workspace-director",
        "model": "openrouter/moonshotai/kimi-k2.5",
        "default": true
      },
      {
        "id": "scheduler",
        "workspace": "/home/node/.openclaw/workspace-scheduler",
        "model": "openrouter/minimax/minimax-m2.7"
      },
      {
        "id": "scout",
        "workspace": "/home/node/.openclaw/workspace-scout",
        "model": "openrouter/moonshotai/kimi-k2.5"
      },
      {
        "id": "pixel",
        "workspace": "/home/node/.openclaw/workspace-pixel",
        "model": "openrouter/minimax/minimax-m2.7"
      },
      {
        "id": "launch",
        "workspace": "/home/node/.openclaw/workspace-launch",
        "model": "openrouter/minimax/minimax-m2.7"
      },
      {
        "id": "quill",
        "workspace": "/home/node/.openclaw/workspace-quill",
        "model": "openrouter/moonshotai/kimi-k2.5"
      },
      {
        "id": "lens",
        "workspace": "/home/node/.openclaw/workspace-lens",
        "model": "openrouter/moonshotai/kimi-k2.5"
      },
      {
        "id": "pulse-tomas",
        "workspace": "/home/node/.openclaw/workspace-pulse-tomas",
        "model": "openrouter/minimax/minimax-m2.7"
      },
      {
        "id": "pulse-misha",
        "workspace": "/home/node/.openclaw/workspace-pulse-misha",
        "model": "openrouter/minimax/minimax-m2.7"
      },
      {
        "id": "pulse-nasik",
        "workspace": "/home/node/.openclaw/workspace-pulse-nasik",
        "model": "openrouter/minimax/minimax-m2.7"
      },
      {
        "id": "pulse-yulya",
        "workspace": "/home/node/.openclaw/workspace-pulse-yulya",
        "model": "openrouter/minimax/minimax-m2.7"
      }
    ]
  },
  "bindings": [
    { "agentId": "director",    "match": { "channel": "telegram", "accountId": "default" } },
    { "agentId": "scheduler",   "match": { "channel": "internal" } },
    { "agentId": "scout",       "match": { "channel": "internal" } },
    { "agentId": "pixel",       "match": { "channel": "internal" } },
    { "agentId": "launch",      "match": { "channel": "internal" } },
    { "agentId": "quill",       "match": { "channel": "internal" } },
    { "agentId": "lens",        "match": { "channel": "internal" } },
    { "agentId": "pulse-tomas", "match": { "channel": "internal" } },
    { "agentId": "pulse-misha", "match": { "channel": "internal" } },
    { "agentId": "pulse-nasik", "match": { "channel": "internal" } },
    { "agentId": "pulse-yulya", "match": { "channel": "internal" } }
  ],
  "channels": {
    "telegram": {
      "accounts": {
        "default": {
          "botToken": "${TELEGRAM_BOT_TOKEN}",
          "dmPolicy": "allowlist",
          "allowFrom": ["tg:${TELEGRAM_OWNER_ID}"]
        }
      }
    }
  }
}
