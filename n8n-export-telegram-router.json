          "jsCode": "const jobId = $json.job_id;\nconst revisionText = $json.revision_text;\nconst fs = require('fs');\n\n// Читаем данные задачи\nconst filePath = `/home/node/shared/approvals/${jobId}.json`;\nlet approvalData;\ntry {\n  approvalData = JSON.parse(fs.readFileSync(filePath, 'utf8'));\n} catch(e) {\n  throw new Error(`Файл не найден: ${filePath}`);\n}\n\nreturn [{\n  json: {\n    ...approvalData,\n    job_id: jobId,\n    revision_text: revisionText,\n    hook_message: `Правки от редактора для job ${jobId}: ${revisionText}. Верни Quill на доработку.`\n  }\n}];"
