      {
        "parameters": {
          "jsCode": "const fs = require('fs');\n\nconst blogger = $json.blogger;\nconst jobId = $json.job_id;\nif (!blogger || !jobId) return [{ json: $json }];\n\nconst reportPath = `/home/node/shared/bloggers/${blogger}/jobs/${jobId}/launch_report.md`;\nconst marker = '## Telegram API result';\n\n// n8n HTTP Request often exposes Telegram response either at root ($json) or in $json.body\nconst telegram = $json.result ? $json : ($json.body?.result ? { result: $json.body.result } : $json);\nconst result = telegram.result || {};\nconst messageId = result.message_id;\n\nlet report = '';\ntry {\n  report = fs.existsSync(reportPath) ? fs.readFileSync(reportPath, 'utf8') : '';\n} catch (e) {\n  // ignore read errors\n}\n\nconst block = `\\n\\n${marker}\\n- message_id: ${messageId ?? ''}\\n`;\nif (report) {\n  if (!report.includes(marker)) {\n    fs.writeFileSync(reportPath, report.trimEnd() + block);\n  } else {\n    // best-effort: replace message_id line if present\n    const replaced = report.replace(/- message_id:\\s*.*\\n/, `- message_id: ${messageId ?? ''}\\n`);\n    fs.writeFileSync(reportPath, replaced);\n  }\n} else {\n  // minimal fallback\n  fs.writeFileSync(reportPath, block);\n}\n\nreturn [{ json: $json }];"
        },
