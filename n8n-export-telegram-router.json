      {
        "parameters": {
          "jsCode": "const jobId = $json.job_id;\nconst action = $json.action;\nconst fs = require('fs');\nconst filePath = `/home/node/shared/approvals/${jobId}.json`;\n\nlet approvalData;\ntry {\n  approvalData = JSON.parse(fs.readFileSync(filePath, 'utf8'));\n} catch(e) {\n  throw new Error(`Файл не найден: ${filePath}`);\n}\n\nconst mu = String(approvalData.media_url || approvalData.image_url || '').trim();\nconst mub = String(approvalData.media_url_b || '').trim();\n\nlet selected_media_url = '';\nif (action === 'approve_a') selected_media_url = mu;\nelse if (action === 'approve_b') selected_media_url = mub;\nelse if (action === 'approve') selected_media_url = mu || mub;\n\nif (selected_media_url && ['approve', 'approve_a', 'approve_b'].includes(action)) {\n  const blogger = approvalData.blogger;\n  const jobDir = `/home/node/shared/bloggers/${blogger}/jobs/${jobId}`;\n  const lockPath = `${jobDir}/published.lock`;\n  try {\n    if (!fs.existsSync(jobDir)) fs.mkdirSync(jobDir, { recursive: true });\n    fs.writeFileSync(lockPath, JSON.stringify({ selected_media_url: selected_media_url }, null, 2));\n  } catch (e) {}\n}\n\nreturn [{\n  json: {\n    ...approvalData,\n    job_id: jobId,\n    image_url: selected_media_url || approvalData.image_url || '',\n    message_id: $json.message_id,\n    chat_id_user: $json.chat_id,\n    callback_query_id: $json.callback_query_id,\n    action\n  }\n}];"
        },
