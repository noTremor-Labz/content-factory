      {
        "parameters": {
          "jsCode": "const text = $json.text;\n\n// Парсим формат: \"правки JOB_ID: текст правок\"\nconst match = text.match(/^правки\\s+(\\S+):\\s*(.+)$/s);\n\nif (!match) {\n  return [{\n    json: {\n      valid: false,\n      raw_text: text\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    job_id: match[1],\n    revision_text: match[2],\n    chat_id: $json.chat_id\n  }\n}];"
